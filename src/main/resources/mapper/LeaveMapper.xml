<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feng.militia_admin.mapper.LeaveMapper">

    <resultMap id="BaseResultMap" type="com.feng.militia_admin.model.domain.Leave">
        <id property="id" column="id" />
        <result property="userId" column="user_id" />
        <result property="userName" column="user_name" />
        <result property="orgId" column="org_id" />
        <result property="leaveType" column="leave_type" />
        <result property="startTime" column="start_time" />
        <result property="endTime" column="end_time" />
        <result property="reason" column="reason" />
        <result property="status" column="status" />
        <result property="auditRemark" column="audit_remark" />
        <result property="auditUserId" column="audit_user_id" />
        <result property="auditUserName" column="audit_user_name" />
        <result property="cancelStatus" column="cancel_status" />
        <result property="cancelTime" column="cancel_time" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
        <result property="isDelete" column="is_delete" />
    </resultMap>

    <sql id="Base_Column_List">
        l.id,
        l.user_id AS userId,
        l.user_name AS userName,
        l.org_id AS orgId,
        o.name AS orgName,
        l.leave_type AS leaveType,
        l.start_time AS startTime,
        l.end_time AS endTime,
        l.reason,
        l.status,
        l.audit_remark AS auditRemark,
        l.audit_user_name AS auditUserName,
        l.cancel_status AS cancelStatus,
        l.cancel_time AS cancelTime,
        l.create_time AS createTime
    </sql>

    <select id="selectLeaveListByOrgId" resultType="com.feng.militia_admin.model.vo.ShowLeaveInfoVo">
        SELECT
        <include refid="Base_Column_List" />
        FROM `leave` l
        INNER JOIN organization o ON l.org_id = o.id
        WHERE o.path LIKE CONCAT(
            (SELECT path FROM organization WHERE id = #{orgId} AND is_delete = 0),
            '%'
        )
        AND l.is_delete = 0
        AND o.is_delete = 0
        ORDER BY l.status DESC, l.create_time DESC
    </select>

    <select id="selectMyLeaveList" resultType="com.feng.militia_admin.model.vo.ShowLeaveInfoVo">
        SELECT
        <include refid="Base_Column_List" />
        FROM `leave` l
        INNER JOIN organization o ON l.org_id = o.id
        WHERE l.user_id = #{userId}
        AND l.is_delete = 0
        AND o.is_delete = 0
        ORDER BY l.create_time DESC
    </select>

</mapper>
